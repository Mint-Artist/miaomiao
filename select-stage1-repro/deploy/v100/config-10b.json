{
  "name": "select-stage1-v100-8k-10b",
  "platform": "cuda",
  "distributed_backend": "nccl",
  "distributed_strategy": "ddp",
  "precision": "fp16",
  "parameter_dtype": "float32",
  "use_grad_scaler": true,
  "gradient_checkpointing": true,
  "fused_optimizer": false,
  "sequence_length": 8192,
  "train_tokens": 9999998976,
  "micro_batch_size": 1,
  "gradient_accumulation_steps": 4,
  "mlm_probability": 0.15,
  "mask_token": "<|mask|>",
  "learning_rate": 5e-05,
  "min_learning_rate": 1e-06,
  "warmup_steps": 1000,
  "weight_decay": 0.1,
  "adam_beta1": 0.9,
  "adam_beta2": 0.95,
  "adam_epsilon": 1e-08,
  "max_grad_norm": 1.0,
  "log_every_steps": 10,
  "save_every_steps": 5000,
  "seed": 42,
  "shuffle": true,
  "base_model": "${SELECT_MODEL_DIR}",
  "data_dir": "${SELECT_DATA_DIR}",
  "output_dir": "${SELECT_OUTPUT_DIR}",
  "resume_from": null,
  "max_optimizer_steps": null,
  "max_consecutive_overflows": 8,
  "process_group_timeout_minutes": 60
}
