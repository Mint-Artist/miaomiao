{
  "name": "select-stage1-ascend910c-8k-smoke",
  "platform": "npu",
  "distributed_backend": "hccl",
  "distributed_strategy": "ddp",
  "precision": "bf16",
  "parameter_dtype": "float32",
  "use_grad_scaler": false,
  "gradient_checkpointing": true,
  "fused_optimizer": false,
  "sequence_length": 8192,
  "train_tokens": 1048576,
  "micro_batch_size": 1,
  "gradient_accumulation_steps": 1,
  "mlm_probability": 0.15,
  "mask_token": "<|mask|>",
  "learning_rate": 0.00005,
  "min_learning_rate": 0.000001,
  "warmup_steps": 1,
  "weight_decay": 0.1,
  "adam_beta1": 0.9,
  "adam_beta2": 0.95,
  "adam_epsilon": 1e-8,
  "max_grad_norm": 1.0,
  "log_every_steps": 1,
  "save_every_steps": 0,
  "seed": 42,
  "shuffle": true,
  "base_model": "${SELECT_MODEL_DIR}",
  "data_dir": "${SELECT_DATA_DIR}",
  "output_dir": "${SELECT_OUTPUT_DIR}",
  "resume_from": null,
  "max_optimizer_steps": 2,
  "max_consecutive_overflows": 8,
  "process_group_timeout_minutes": 30
}
