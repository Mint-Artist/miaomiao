<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>extractor</groupId>
  <artifactId>spark-scala-extractor</artifactId>
  <version>0.2.2-scala211</version>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <scala.version>2.11.12</scala.version>
    <scala.binary.version>2.11</scala.binary.version>
    <spark.version>2.4.8</spark.version>
    <jsoup.version>1.18.3</jsoup.version>
    <json.version>20240303</json.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.scala-lang</groupId><artifactId>scala-library</artifactId>
      <version>${scala.version}</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.spark</groupId><artifactId>spark-sql_${scala.binary.version}</artifactId>
      <version>${spark.version}</version><scope>provided</scope>
    </dependency>
    <dependency><groupId>org.jsoup</groupId><artifactId>jsoup</artifactId><version>${jsoup.version}</version></dependency>
    <dependency><groupId>org.json</groupId><artifactId>json</artifactId><version>${json.version}</version></dependency>
  </dependencies>
  <build>
    <finalName>spark-scala-extractor-scala211</finalName>
    <!-- 项目源文件保持在仓库根目录；只编译主程序，测试由 scala-cli 2.12 入口执行 -->
    <sourceDirectory>.</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>net.alchim31.maven</groupId><artifactId>scala-maven-plugin</artifactId><version>4.9.2</version>
        <executions><execution><goals><goal>compile</goal></goals></execution></executions>
        <configuration>
          <sourceDir>.</sourceDir>
          <includes>
            <include>ContentLocator.scala</include>
            <include>Profiles.scala</include>
            <include>SimplifyFile.scala</include>
            <include>SimplifyHtml.scala</include>
            <include>SimplifyHtmlJob.scala</include>
          </includes>
          <args><arg>-deprecation</arg><arg>-feature</arg><arg>-unchecked</arg><arg>-target:jvm-1.8</arg></args>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version>
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals>
          <configuration>
            <createDependencyReducedPom>false</createDependencyReducedPom>
            <relocations>
              <relocation><pattern>org.jsoup</pattern><shadedPattern>extractor.internal.jsoup</shadedPattern></relocation>
              <relocation><pattern>org.json</pattern><shadedPattern>extractor.internal.org.json</shadedPattern></relocation>
            </relocations>
            <filters><filter><artifact>*:*</artifact><excludes><exclude>module-info.class</exclude></excludes></filter></filters>
          </configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
